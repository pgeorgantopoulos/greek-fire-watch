<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Greek Fire Watch — {{ report.date }}</title>
<style>
  :root {
    --bg: #f7f5f2;
    --panel: #ffffff;
    --border: #e2ddd6;
    --text: #24211d;
    --muted: #6b6459;
    --accent: #c1440e;
    --accent-soft: #fbe9e2;
    --ok: #2e7d32;
    --warn: #b8860b;
    --err: #b3261e;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.5;
  }
  .wrap { max-width: 960px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
  header.page { margin-bottom: 1.5rem; }
  header.page h1 { margin: 0 0 0.25rem; font-size: 1.75rem; }
  header.page .meta { color: var(--muted); font-size: 0.9rem; }
  header.page .meta a { color: var(--accent); text-decoration: none; }
  header.page .meta a:hover { text-decoration: underline; }

  .status-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 2rem; }
  .status-badge {
    font-size: 0.78rem; padding: 0.2rem 0.6rem; border-radius: 999px;
    border: 1px solid var(--border); color: var(--muted);
  }
  .status-badge.ok { color: var(--ok); border-color: var(--ok); }
  .status-badge.disabled { color: var(--muted); }
  .status-badge.skipped { color: var(--warn); border-color: var(--warn); }
  .status-badge.error { color: var(--err); border-color: var(--err); }

  section { margin-bottom: 2.5rem; }
  section h2 {
    font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--muted); margin-bottom: 0.75rem;
  }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; }
  .card {
    background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
    padding: 1rem;
  }
  .card .num { font-size: 1.8rem; font-weight: 700; color: var(--accent); }
  .card .label { color: var(--muted); font-size: 0.85rem; }

  table { width: 100%; border-collapse: collapse; background: var(--panel); border-radius: 10px; overflow: hidden; }
  table caption { text-align: left; color: var(--muted); font-size: 0.85rem; margin-bottom: 0.5rem; }
  th, td { text-align: left; padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--border); font-size: 0.88rem; }
  th { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  tbody tr:hover { background: #faf7f4; }
  .table-scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; }
  .table-scroll table { border: none; border-radius: 0; }

  .news-list { display: flex; flex-direction: column; gap: 0.9rem; }
  .news-item {
    background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 0.9rem 1.1rem;
  }
  .news-item h3 { margin: 0 0 0.25rem; font-size: 1rem; }
  .news-item h3 a { color: var(--text); text-decoration: none; }
  .news-item h3 a:hover { color: var(--accent); }
  .news-item .date { color: var(--muted); font-size: 0.8rem; margin-bottom: 0.35rem; }
  .news-item p { margin: 0; font-size: 0.9rem; }

  .empty { color: var(--muted); font-style: italic; padding: 0.75rem 0; }

  .chart-card { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 1rem 1.25rem 0.5rem; }
  .chart-svg { width: 100%; height: auto; display: block; overflow: visible; }
  .chart-svg .gridline { stroke: var(--border); stroke-width: 1; }
  .chart-svg .axis-label { fill: var(--muted); font-size: 10px; }
  .chart-svg .area { fill: var(--accent); fill-opacity: 0.1; }
  .chart-svg .line { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .chart-svg .dot { fill: var(--accent); stroke: var(--panel); stroke-width: 2; r: 4; }
  .chart-svg .hit { fill: transparent; cursor: crosshair; }
  .chart-svg .end-label { fill: var(--text); font-size: 11px; font-weight: 600; }
  .chart-svg .crosshair { stroke: var(--muted); stroke-width: 1; opacity: 0; pointer-events: none; }
  .chart-tooltip {
    position: absolute; pointer-events: none; opacity: 0; transition: opacity 0.1s;
    background: var(--text); color: #fff; font-size: 0.78rem; padding: 0.35rem 0.55rem;
    border-radius: 6px; white-space: nowrap; transform: translate(-50%, -110%);
  }
  .chart-tooltip .val { font-weight: 700; }
  .chart-wrap { position: relative; }

  details.table-view summary { cursor: pointer; color: var(--accent); font-size: 0.85rem; margin: 0.5rem 0 0; }
  details.table-view table { margin-top: 0.5rem; }

  footer.page { border-top: 1px solid var(--border); padding-top: 1.25rem; color: var(--muted); font-size: 0.82rem; }
  footer.page a { color: var(--accent); }
</style>
</head>
<body>
<div class="wrap">

  <header class="page">
    <h1>🔥 Greek Fire Watch</h1>
    <div class="meta">
      Daily report for <strong>{{ report.date }}</strong> ({{ report.region }})
      &middot; generated {{ report.generated_at }}
      &middot; <a href="{{ base_path }}archive/index.html">archive</a>
    </div>
    <div class="status-row">
      {% for name, status in report.source_status.items() %}
        {% set css_class = 'ok' if status == 'ok' else ('disabled' if status == 'disabled' else ('skipped' if status.startswith('skipped') else 'error')) %}
        <span class="status-badge {{ css_class }}">
          {{ name }}: {{ status }}
        </span>
      {% endfor %}
    </div>
  </header>

  <section>
    <h2>Summary</h2>
    <div class="cards">
      <div class="card">
        <div class="num">{{ report.summary.total_detections }}</div>
        <div class="label">Active fire detections</div>
      </div>
      {% for source, count in report.summary.by_source.items() %}
      <div class="card">
        <div class="num">{{ count }}</div>
        <div class="label">from {{ source }}</div>
      </div>
      {% endfor %}
      <div class="card">
        <div class="num">{{ report.news|length }}</div>
        <div class="label">Civil Protection news items</div>
      </div>
    </div>
    {% if report.summary.top_regions %}
    <p style="margin-top:1rem; color: var(--muted); font-size: 0.9rem;">
      Most affected: {% for region, count in report.summary.top_regions %}{{ region }} ({{ count }}){{ ", " if not loop.last }}{% endfor %}
    </p>
    {% endif %}
  </section>

  <section>
    <h2>History (all-time)</h2>
    <div class="cards">
      <div class="card">
        <div class="num">{{ history.days_tracked }}</div>
        <div class="label">Days tracked</div>
      </div>
      <div class="card">
        <div class="num">{{ history.all_time_total }}</div>
        <div class="label">All-time detections</div>
      </div>
      <div class="card">
        <div class="num">{{ history.avg_per_day }}</div>
        <div class="label">Avg detections / day</div>
      </div>
    </div>

    {% if trend_chart %}
    <div class="chart-card" style="margin-top:1rem;">
      <div class="chart-wrap">
        <svg class="chart-svg" viewBox="0 0 {{ trend_chart.width }} {{ trend_chart.height }}" id="trend-chart">
          {% for tick in trend_chart.y_ticks %}
          <line class="gridline" x1="36" x2="{{ trend_chart.width - 12 }}" y1="{{ tick.y }}" y2="{{ tick.y }}"></line>
          <text class="axis-label" x="4" y="{{ tick.y + 3 }}">{{ tick.label }}</text>
          {% endfor %}
          {% for tick in trend_chart.x_ticks %}
          <text class="axis-label" x="{{ tick.x }}" y="{{ trend_chart.height - 8 }}" text-anchor="middle">{{ tick.date[5:] }}</text>
          {% endfor %}
          <path class="area" d="{{ trend_chart.area_d }}"></path>
          <path class="line" d="{{ trend_chart.line_d }}"></path>
          {% set last = trend_chart.points[-1] %}
          <text class="end-label" x="{{ last.x - 6 }}" y="{{ last.y - 10 }}" text-anchor="end">{{ last.total }}</text>
          {% for p in trend_chart.points %}
          <circle class="dot" cx="{{ p.x }}" cy="{{ p.y }}"></circle>
          <circle class="hit" cx="{{ p.x }}" cy="{{ p.y }}" r="14" data-date="{{ p.date }}" data-total="{{ p.total }}" tabindex="0"></circle>
          {% endfor %}
          <line class="crosshair" id="trend-crosshair" y1="16" y2="{{ trend_chart.plot_bottom }}"></line>
        </svg>
        <div class="chart-tooltip" id="trend-tooltip"><span class="val"></span> on <span class="date"></span></div>
      </div>
    </div>
    <script>
      (function () {
        var svg = document.getElementById('trend-chart');
        var tooltip = document.getElementById('trend-tooltip');
        var crosshair = document.getElementById('trend-crosshair');
        var valEl = tooltip.querySelector('.val');
        var dateEl = tooltip.querySelector('.date');
        var chartWidth = {{ trend_chart.width }};

        function show(e) {
          var hit = e.currentTarget;
          var cx = hit.getAttribute('cx');
          var cy = hit.getAttribute('cy');
          var total = hit.getAttribute('data-total');
          var date = hit.getAttribute('data-date');
          valEl.textContent = total + (total === '1' ? ' detection' : ' detections');
          dateEl.textContent = date;
          crosshair.setAttribute('x1', cx);
          crosshair.setAttribute('x2', cx);
          crosshair.style.opacity = 1;
          var rect = svg.getBoundingClientRect();
          var scale = rect.width / chartWidth;
          tooltip.style.left = (cx * scale) + 'px';
          tooltip.style.top = (cy * scale) + 'px';
          tooltip.style.opacity = 1;
        }
        function hide() {
          crosshair.style.opacity = 0;
          tooltip.style.opacity = 0;
        }
        svg.querySelectorAll('.hit').forEach(function (hit) {
          hit.addEventListener('pointerenter', show);
          hit.addEventListener('focus', show);
          hit.addEventListener('pointerleave', hide);
          hit.addEventListener('blur', hide);
        });
      })();
    </script>
    {% else %}
    <p class="empty">Not enough historical data yet for a trend chart — check back after a few daily runs.</p>
    {% endif %}

    {% if history.all_time_top_regions %}
    <p style="margin-top:1rem; color: var(--muted); font-size: 0.9rem;">
      All-time most affected: {% for region, count in history.all_time_top_regions %}{{ region }} ({{ count }}){{ ", " if not loop.last }}{% endfor %}
    </p>
    {% endif %}

    <details class="table-view">
      <summary>View daily totals as a table</summary>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Date</th><th>Total detections</th><th>By source</th><th>News items</th></tr>
          </thead>
          <tbody>
            {% for d in history.daily | reverse %}
            <tr>
              <td><a href="{{ base_path }}archive/{{ d.date }}.html">{{ d.date }}</a></td>
              <td>{{ d.total }}</td>
              <td>{% if d.by_source %}{% for src, count in d.by_source.items() %}{{ src }}: {{ count }}{{ ", " if not loop.last }}{% endfor %}{% else %}—{% endif %}</td>
              <td>{{ d.news_count }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>

  <section>
    <h2>Active fire detections</h2>
    {% if report.detections %}
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Source</th>
            <th>Region</th>
            <th>Coordinates</th>
            <th>Acquired</th>
            <th>Confidence</th>
            <th>FRP / Area (ha)</th>
            <th>Map</th>
          </tr>
        </thead>
        <tbody>
          {% for d in report.detections %}
          <tr>
            <td>{{ d.source }}</td>
            <td>{{ d.region | default('—') }}</td>
            <td><a href="https://www.google.com/maps/search/?api=1&query={{ d.lat }},{{ d.lon }}" target="_blank" rel="noopener">{{ "%.4f"|format(d.lat) }}, {{ "%.4f"|format(d.lon) }}</a></td>
            <td>{{ d.acquired_at | default('—') }}</td>
            <td>{{ d.confidence | default('—') }}</td>
            <td>{{ d.frp | default(d.area_ha) | default('—') }}</td>
            <td>
              {% if d.map_link %}<a href="{{ d.map_link }}" target="_blank" rel="noopener">view</a>{% else %}—{% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="empty">No active fire detections reported for this run.</p>
    {% endif %}
  </section>

  <section>
    <h2>Civil Protection news</h2>
    {% if report.news %}
    <div class="news-list">
      {% for item in report.news %}
      <div class="news-item">
        <h3><a href="{{ item.link }}" target="_blank" rel="noopener">{{ item.title }}</a></h3>
        <div class="date">{{ item.published_at | default('—') }}</div>
        {% if item.summary %}<p>{{ item.summary }}</p>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="empty">No matching Civil Protection announcements for this run.</p>
    {% endif %}
  </section>

  <footer class="page">
    <p>
      Data sources: <a href="https://firms.modaps.eosdis.gov/" target="_blank" rel="noopener">NASA FIRMS</a>,
      <a href="https://effis.jrc.ec.europa.eu/" target="_blank" rel="noopener">EFFIS</a>,
      Greek Civil Protection RSS. See project README for attribution details and known limitations.
    </p>
  </footer>

</div>
</body>
</html>
